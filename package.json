{
  "name": "vent-simulator-2d",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{js,ts,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{js,ts,json,html}\"",
    "clean": "rm -rf dist coverage",
    "prebuild": "npm run clean",
    "build": "tsc -b && vite build",
    "build:analyze": "vite build --mode analyze",
    "build:visualize": "vite-bundle-visualizer --output artifacts/bundle-report.html --open false",
    "check:completion-audit": "node scripts/assert-completion-audit.mjs",
    "check:deep-audit-completion": "node scripts/assert-deep-audit-completion.mjs",
    "check:deep-audit-handoff": "node scripts/assert-deep-audit-handoff.mjs",
    "check:completion-evidence": "node scripts/update-completion-evidence-manifests.mjs --dry-run && node scripts/assert-completion-consistency.mjs",
    "check:completion-consistency": "node scripts/assert-completion-consistency.mjs",
    "check:phase-gates": "node scripts/record-phase-gate-evidence.mjs",
    "record:final-command-evidence": "node scripts/record-final-command-evidence.mjs",
    "record:multi-environment-evidence": "node scripts/record-multi-environment-evidence.mjs",
    "record:patient-visual-review-packet": "node scripts/record-patient-visual-review-packet.mjs",
    "record:external-review-packets": "node scripts/record-external-review-packets.mjs",
    "check:strict-accessibility": "node scripts/record-strict-accessibility-scan.mjs",
    "check:remaining-blockers": "node scripts/report-remaining-blockers.mjs",
    "refresh:completion-evidence": "node scripts/refresh-completion-evidence.mjs",
    "refresh:crux-blocker-evidence": "node scripts/refresh-crux-blocker-evidence.mjs",
    "sync:remote-crux-evidence": "node scripts/sync-remote-crux-evidence.mjs",
    "update:crux-blocker-issue": "node scripts/update-crux-blocker-issue.mjs",
    "update:completion-evidence": "node scripts/update-completion-evidence-manifests.mjs",
    "write:final-blocker-summary": "node scripts/write-final-blocker-summary.mjs",
    "docs:api": "typedoc --options typedoc.json",
    "docs:codemap": "node scripts/generate-codemap.mjs",
    "docs:pdf": "node scripts/generate-manual-pdfs.mjs",
    "docs:storybook": "storybook build --output-dir docs/storybook",
    "check:bundle-size": "node scripts/assert-bundle-budget.mjs",
    "check:contrast": "node scripts/assert-color-contrast.mjs",
    "check:cost-monitoring": "node scripts/assert-cost-monitoring.mjs",
    "check:crux-credentials": "node scripts/check-crux-credentials.mjs",
    "check:crux-live-probes": "node scripts/check-crux-live-probes.mjs",
    "check:crux-monitoring": "node scripts/check-crux-monitoring.mjs",
    "check:pages-domain": "node scripts/check-pages-domain.mjs",
    "check:remote-crux-workflow": "node scripts/check-remote-crux-workflow.mjs",
    "check:remote-crux-latest": "node scripts/check-latest-remote-crux-run.mjs",
    "check:forbidden-patterns": "node scripts/assert-forbidden-patterns.mjs",
    "check:test-realism": "node scripts/assert-test-realism.mjs",
    "check:licenses": "node scripts/assert-license-policy.mjs",
    "check:jsdoc-exports": "node scripts/assert-jsdoc-exports.mjs",
    "check:lighthouse": "node scripts/assert-lighthouse.mjs",
    "check:memory": "node scripts/assert-memory-profile.mjs",
    "check:memory:10min": "node scripts/assert-long-memory-profile.mjs",
    "check:memory:30min": "LONG_MEMORY_DURATION_MS=1800000 LONG_MEMORY_MIN_DURATION_MS=1800000 LONG_MEMORY_ARTIFACT=artifacts/memory-profile-30min.json node scripts/assert-long-memory-profile.mjs",
    "check:memory:1hour": "LONG_MEMORY_DURATION_MS=3600000 LONG_MEMORY_MIN_DURATION_MS=3600000 LONG_MEMORY_ARTIFACT=artifacts/memory-profile-1hour.json node scripts/assert-long-memory-profile.mjs",
    "check:no-raster": "node scripts/assert-no-raster-assets.mjs",
    "check:performance": "node scripts/assert-performance-budget.mjs",
    "check:pdf-accessibility": "node scripts/assert-pdf-accessibility.mjs",
    "check:sbom": "npm sbom --omit=dev --sbom-format cyclonedx --sbom-type application --json > artifacts/sbom.json",
    "demo:record": "node scripts/record-demo.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:list": "vitest list --json artifacts/vitest-list.json",
    "test:watch": "vitest",
    "test:coverage": "npm run test:list && vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "preact": "^10.29.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@storybook/react-vite": "^10.3.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-vitest": "^0.5.4",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.3.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^10.3.6",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "terser": "^5.47.1",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.11",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^4.1.5"
  }
}
